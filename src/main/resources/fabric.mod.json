  "name": "Low Simulation Distance",
  "description": "Sets minimum simulation and render distance into 1 (not recommended for normal gameplay!)",
  "authors": [],
  "contact": {},

  "license": "MIT",
  "icon": "assets/low_simulation_distance/icon.png",

  "environment": "*",
